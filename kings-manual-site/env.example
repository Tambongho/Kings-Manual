# Copy this file to .env.local for local development, and add the same
# keys in Vercel Project Settings → Environment Variables for production.
# Never commit real keys to git.

# Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=

# Your production site URL, used as a fallback if the request Origin
# header is unavailable (rare). Set this to https://kingsmanual.com in Vercel.
NEXT_PUBLIC_SITE_URL=https://kingsmanual.com
